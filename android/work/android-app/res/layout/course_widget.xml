<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_light">
    <ImageView android:id="@+id/widget_glass_surface" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="@null" android:visibility="gone" />
    <LinearLayout
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:textFontWeight="500" android:fontFamily="@font/suike_numbers" android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="随课" android:textSize="12sp" />
        <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/widget_lamp" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" />
        <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节" android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_course_block" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:textFontWeight="500" android:fontFamily="@font/suike_numbers" android:id="@+id/widget_course" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="20sp" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" />
            <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_room" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="8dp" android:scaleType="fitXY" android:visibility="gone" />
    <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" android:text="添加课程后在这里查看" />
    <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    <TextView android:fontFamily="@font/suike_numbers" android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>
</FrameLayout>
